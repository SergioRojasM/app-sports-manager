# Supabase Configuration
# Get these values from Supabase Dashboard → Settings → API

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public key (safe to expose to frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────────────────────
# Server-only — NEVER prefix with NEXT_PUBLIC_ (US-0114)
# ─────────────────────────────────────────────────────────────

# Supabase service-role key. Used only by server route handlers under src/app/api
# for auth.admin.* calls (invitations, administrator-provisioned accounts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Trusted application origin used to build Auth email links (never derived from request headers).
# Local: http://localhost:3000 · Production: https://www.grit-arena.com
APP_URL=http://localhost:3000

# Notifications module (US-0125)
# Resend API key with sending access for the EMAIL_FROM domain. Empty = emails are not sent
# (outbox rows fail with `resend_not_configured`).
RESEND_API_KEY=

# Sender of application emails, e.g. GRIT Arena <no-reply@grit-arena.com>
EMAIL_FROM=

# Bearer secret of POST /api/internal/notificaciones/despachar. Must match the
# `notificaciones_dispatch_secret` secret stored in Supabase Vault.
# select vault.create_secret('http://host.docker.internal:3000/api/internal/notificaciones/despachar', 'notificaciones_dispatch_url');
# select vault.create_secret('021d9ac6583c8d6289d3a0ecc871c16a6188e6015a267d4c', 'notificaciones_dispatch_secret');

NOTIFICACIONES_DISPATCH_SECRET=

# Development only (ignored when NODE_ENV=production): when set, emails go to the local Mailpit
# of the Supabase CLI instead of Resend, so nothing is really sent. Inbox: http://127.0.0.1:54324
# EMAIL_DEV_MAILPIT_URL=http://127.0.0.1:54324
